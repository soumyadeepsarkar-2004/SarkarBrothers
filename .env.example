# =====================================================
# SARKARBROTHERS VERCEL PRODUCTION ENVIRONMENT VARIABLES
# =====================================================

# -----------------------------------------------------
# ADD TO: BACKEND VERCEL PROJECT
# -----------------------------------------------------

# 1. DATABASE (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/sarkarbrothers

# 2. AUTHENTICATION
# Generate a secure 64+ char random string
JWT_SECRET=generate_a_very_secure_long_random_string_here

# 3. PAYMENTS (Stripe)
# Get keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 4. IMAGE STORAGE (Cloudinary)
# Get keys: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. AI INTEGRATION
GEMINI_API_KEY=your_gemini_api_key


# -----------------------------------------------------
# ADD TO: FRONTEND VERCEL PROJECT (STOREFRONT)
# -----------------------------------------------------
# This must be your LIVE public key (starts with pk_live_)
VITE_STRIPE_PUBLIC_KEY=pk_live_...


# -----------------------------------------------------
# ADD TO: OWNER PORTAL VERCEL PROJECT
# -----------------------------------------------------
# No specific env variables needed strictly for the frontend owner portal yet,
# but it communicates with the backend via the same Auth endpoints.
