# =====================================================
# DUAL-PORTAL E-COMMERCE CONFIGURATION
# Production-Ready Multi-Tenant SaaS Platform
# =====================================================

# 1. BACKEND CORE
# =====================================================
NODE_ENV=development
PORT=5000

# 2. DATABASE (MongoDB Atlas - Row-Level Security Model)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/sarkarbrothers

# 3. AUTHENTICATION (JWT with Role-Based Claims)
# Min 32 chars; MUST change in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min32chars

# 4. PAYMENTS (Stripe PCI-DSS Level 1)
# Get keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# For production, add:
# STRIPE_SECRET_KEY=sk_live_your_production_key
# STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# 5. AI INTEGRATION (Google Gemini)
# Get key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 6. FRONTEND PORTAL URLs (for CORS validation)
CUSTOMER_PORTAL_URL=http://localhost:3001
ADMIN_PORTAL_URL=http://localhost:3002

# 7. DEPLOYMENT MODE
# Set to 'false' for local development with mock data fallback
PRODUCTION_MODE=false

# 8. FEATURE FLAGS
USE_MOCK_BACKEND=true
ENABLE_DEMO_DATA=true

# 9. LOGGING & MONITORING (Optional)
LOG_LEVEL=debug
SENTRY_DSN=

# 10. AWS DEPLOYMENT (Staging for Lambda Migration)
# AWS_REGION=us-east-1
# AWS_LAMBDA_FUNCTION_NAME=sarkarbrothers-api
# AWS_S3_BUCKET=sarkarbrothers-products
# AWS_RDS_ENDPOINT=db.example.c9akciq32.us-east-1.rds.amazonaws.com

# 11. FIREBASE (Optional - Legacy Google Sign-In)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# =====================================================
# DEPLOYMENT INSTRUCTIONS
# =====================================================
# Local Development:
#   1. npm install (root)
#   2. npm run dev:portals (starts both portals + backend)
#   3. Open: http://localhost:3001 (customer) + http://localhost:3002 (admin)
#
# Production (AWS Lambda + S3):
#   1. Build both portals: npm run build:portals
#   2. Deploy to S3: aws s3 sync admin-portal/dist s3://bucket/admin/
#   3. Deploy backend: npm run deploy:lambda
#   4. Set environment variables in Lambda console
#   5. Point CloudFront to S3 + API Gateway to Lambda
#
# Stripe Webhook Setup:
#   Local: npx stripe listen --forward-to localhost:5000/api/webhooks/stripe
#   Production: Configure in Stripe Dashboard → Webhooks
#               Endpoint: https://api.sarkarbrothers.com/api/webhooks/stripe
#               Events: payment_intent.succeeded, payment_intent.payment_failed
