# AWS Deployment Configuration
# This file contains environment variables for different deployment stages

# DEVELOPMENT STAGE
# Run: serverless deploy --stage dev

STAGE=dev
AWS_REGION=ap-south-1

# Database
MONGODB_URI=mongodb+srv://user:password@dev-cluster.mongodb.net/sarkarbrothers-dev?retryWrites=true&w=majority

# JWT & Security
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRY=7d

# Stripe (Test Keys)
STRIPE_PUBLIC_KEY=pk_test_your_test_public_key
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# Gemini API
GEMINI_API_KEY=your_test_gemini_key

# CORS & Security
CORS_ORIGIN=*
NODE_ENV=development

# Logging
LOG_LEVEL=debug

---

# STAGING STAGE
# Run: serverless deploy --stage staging

STAGE=staging
AWS_REGION=ap-south-1

# Database
MONGODB_URI=mongodb+srv://user:password@staging-cluster.mongodb.net/sarkarbrothers-staging?retryWrites=true&w=majority

# JWT & Security
JWT_SECRET=staging-secret-key-change-before-prod
JWT_EXPIRY=7d

# Stripe (Test Keys)
STRIPE_PUBLIC_KEY=pk_test_staging_public_key
STRIPE_SECRET_KEY=sk_test_staging_secret_key
STRIPE_WEBHOOK_SECRET=whsec_staging_webhook_secret

# Gemini API
GEMINI_API_KEY=your_staging_gemini_key

# CORS & Security
CORS_ORIGIN=https://staging.sarkarbrothers.com
NODE_ENV=staging

# Logging
LOG_LEVEL=info

---

# PRODUCTION STAGE
# Run: serverless deploy --stage prod
# WARNING: Use AWS Secrets Manager for production values!

STAGE=prod
AWS_REGION=ap-south-1

# Database (Retrieve from AWS Secrets Manager)
# MONGODB_URI=${SSM:/sarkarbrothers/prod/mongodb-uri}

# JWT & Security (Retrieve from AWS Secrets Manager)
# JWT_SECRET=${SSM:/sarkarbrothers/prod/jwt-secret~true}
# JWT_EXPIRY=7d

# Stripe Live Keys (Retrieve from AWS Secrets Manager)
# STRIPE_PUBLIC_KEY=${SSM:/sarkarbrothers/prod/stripe-public-key}
# STRIPE_SECRET_KEY=${SSM:/sarkarbrothers/prod/stripe-secret~true}
# STRIPE_WEBHOOK_SECRET=${SSM:/sarkarbrothers/prod/stripe-webhook~true}

# Gemini API (Retrieve from AWS Secrets Manager)
# GEMINI_API_KEY=${SSM:/sarkarbrothers/prod/gemini-key~true}

# CORS & Security
CORS_ORIGIN=https://www.sarkarbrothers.com,https://admin.sarkarbrothers.com
NODE_ENV=production

# Logging
LOG_LEVEL=warn

# Monitoring
CLOUDWATCH_METRICS_ENABLED=true
X_RAY_TRACING_ENABLED=true
