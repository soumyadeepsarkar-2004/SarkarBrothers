{
  "name": "sarkarbrothers-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index-v2.js",
    "server:dev": "nodemon server/index-v2.js",
    "server:legacy": "node server/index.js",
    "seed": "node server/seed.js",
    "start": "npm run server",
    "dev:owner": "cd owner-portal && npm run dev",
    "dev:server": "npm run server:dev",
    "dev:portals": "concurrently \"npm run dev\" \"npm run dev:server\" \"npm run dev:owner\"",
    "build:owner": "cd owner-portal && npm run build",
    "build:portals": "npm run build && npm run build:owner",
    "preview:owner": "cd owner-portal && npm run preview"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.15.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "postcss": "^8.5.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "stripe": "^22.3.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "typescript": "~6.0.3",
    "vite": "^8.1.2"
  }
}
